    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "cross-env": "^10.1.0",
    "expect-webdriverio": "^5.7.0",
    "typescript": "^7.0.2",
    "webdriverio": "^9.30.1"
  }
}
