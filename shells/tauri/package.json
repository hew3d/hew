  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/stage-cli-sidecar.mjs && tauri dev",
    "build": "node scripts/stage-cli-sidecar.mjs && tauri build",
    "e2e:build": "node scripts/stage-cli-sidecar.mjs && cross-env VITE_HEW_TEST=1 tauri build --debug --no-bundle",
