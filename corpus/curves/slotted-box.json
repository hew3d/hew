{
  "title": "A 120 x 80 x 30 mm box with a 60 x 16 x 12 mm stadium slot cut into its top",
  "from": "A pocket with straight sides and half-circle ends: the rim where the slot meets the top face, the floor rim at the bottom of the pocket, and the box's own outer loop around it.",
  "build": [
    {
      "method": "hew.sketch.draw_rect",
      "as": "base",
      "params": {"plane": {"ground": true}, "corner_a": [0, 0, 0], "corner_b": ["120mm", "80mm", 0]}
    },
    {
      "method": "hew.solid.extrude",
      "as": "box",
      "params": {"region": {"$ref": "base#/region_id"}, "distance": "30mm"}
    },
    {
      "method": "hew.sketch.draw_line",
      "as": "s1",
      "params": {
        "plane": {"origin": [0, 0, "18mm"], "normal": [0, 0, 1]},
        "points": [["38mm", "32mm", "18mm"], ["82mm", "32mm", "18mm"]]
      }
    },
    {
      "method": "hew.sketch.draw_arc",
      "as": "s2",
      "params": {
        "plane": {"sketch": {"$ref": "s1#/sketch"}},
        "center": ["82mm", "40mm", "18mm"],
        "radius": "8mm",
        "start_angle": -1.5707963267948966,
        "end_angle": 1.5707963267948966
      }
    },
    {
      "method": "hew.sketch.draw_line",
      "as": "s3",
      "params": {
        "plane": {"sketch": {"$ref": "s1#/sketch"}},
        "points": [["82mm", "48mm", "18mm"], ["38mm", "48mm", "18mm"]]
      }
    },
    {
      "method": "hew.sketch.draw_arc",
      "as": "s4",
      "params": {
        "plane": {"sketch": {"$ref": "s1#/sketch"}},
        "center": ["38mm", "40mm", "18mm"],
        "radius": "8mm",
        "start_angle": 1.5707963267948966,
        "end_angle": 4.71238898038469
      }
    },
    {
      "method": "hew.solid.extrude",
      "as": "cutter",
      "params": {"region": {"$ref": "s4#/region_id"}, "distance": "14mm"}
    },
    {
      "method": "hew.solid.subtract",
      "as": "slotted",
      "params": {"a": {"$ref": "box#/object_id"}, "b": {"$ref": "cutter#/object_id"}}
    }
  ],
  "cases": [
    {
      "id": "slot-rim-round",
      "note": "The slot's wall is 12 mm tall, so nothing past 12 mm can exist on its rim; up to 11 mm fits.",
      "method": "hew.solid.fillet",
      "params": {
        "edges": [
          {
            "face": {"object": {"$ref": "slotted#/result"}, "at": ["60mm", "10mm", "30mm"]},
            "loop_near": ["60mm", "32mm", "30mm"]
          }
        ]
      },
      "sizes": ["0.1mm", "1mm", "3mm", "6mm", "11mm", "12mm", "13mm", "20mm"],
      "fits_to": "11mm",
      "never_above": "12mm",
      "volume": "less"
    },
