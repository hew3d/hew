{
  "profile": "app",
  "frames": [
    {
      "compare": "/result/profile",
      "note": "the handshake",
      "request": {
        "id": 0,
        "jsonrpc": "2.0",
        "method": "hew.meta.hello",
        "params": {
          "protocol": 1
        }
      },
      "response": "app"
    },
    {
      "note": "attach binds the connection",
      "request": {
        "id": 1,
        "jsonrpc": "2.0",
        "method": "hew.doc.attach",
        "params": {}
      },
      "response": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {}
      }
    },
    {
      "compare": "/result/results/1/object_id",
      "note": "the board",
      "request": {
        "id": 2,
        "jsonrpc": "2.0",
        "method": "hew.doc.transact",
        "params": {
          "label": "board",
          "commands": [
            {
              "as": "r",
              "method": "hew.sketch.draw_rect",
              "params": {
                "corner_a": [
                  0.0,
                  0.0,
                  0.0
                ],
                "corner_b": [
                  0.4,
                  0.2,
                  0.0
                ],
                "plane": {
                  "ground": true
                }
              }
            },
            {
              "method": "hew.solid.extrude",
              "params": {
                "distance": 0.018,
                "region": {
                  "$ref": "r#/region_id"
                }
              }
            }
          ]
        }
      },
      "response": "obj_1"
    },
    {
      "note": "the clock before the copy",
      "request": {
        "id": 3,
        "jsonrpc": "2.0",
        "method": "hew.history.status",
        "params": {}
      },
      "response": 3,
      "compare": "/result/generation"
    },
    {
      "note": "a copy links by default: the board is wrapped and placed twice",
      "request": {
        "id": 4,
        "jsonrpc": "2.0",
        "method": "hew.entity.move",
        "params": {
          "ids": [
            "obj_1"
          ],
          "translation": [
            1.0,
            0.0,
            0.0
          ],
          "copy": {}
        }
      },
      "response": {
        "id": 4,
        "jsonrpc": "2.0",
        "result": {
          "label": "hew.entity.move",
          "results": [
            {
              "ids": [
                "ins_4"
              ],
              "linked": [
                {
                  "definition": "cmp_2",
                  "instance": "ins_3",
                  "source": "obj_1"
                }
              ]
            }
          ]
        }
      }
    },
    {
      "note": "the change set names the wrap and what each new placement was copied from",
      "request": {
        "id": 5,
        "jsonrpc": "2.0",
        "method": "hew.query.changes_since",
        "params": {
          "generation": 3
        }
      },
      "response": {
        "added": [
          "cmp_2",
          "ins_3",
          "ins_4"
        ],
        "attrs": [],
        "copied_from": [
          [
            "ins_4",
            "ins_3"
          ]
        ],
        "document": false,
        "full": false,
        "linked": [
          {
            "definition": "cmp_2",
            "instance": "ins_3",
            "source": "obj_1"
          }
        ],
        "modified": [
          "obj_1"
        ],
        "removed": []
      },
      "compare": "/result/changes"
    },
    {
      "note": "two placements of one linked set",
      "request": {
        "id": 6,
        "jsonrpc": "2.0",
        "method": "hew.query.occurrences",
        "params": {
          "kinds": [
            "instance"
          ]
        }
      },
      "response": [
        {
          "definition": "cmp_2",
          "definition_name": null,
          "depth": 0,
          "hidden": false,
          "id": "ins_3",
          "kind": "instance",
          "linked": true,
          "material": null,
          "material_effective": null,
          "members": {
