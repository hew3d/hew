            0.0,
            0.0,
            1.0,
            0.0
          ]
        }
      ],
      "compare": "/result/occurrences"
    },
    {
      "note": "copying a placement independently makes another placement (an instance copies as one either way)",
      "request": {
        "id": 7,
        "jsonrpc": "2.0",
        "method": "hew.entity.move",
        "params": {
          "ids": [
            "ins_4"
          ],
          "translation": [
            0.0,
            1.0,
            0.0
          ],
          "copy": {
            "linked": false
          }
        }
      },
      "response": {
        "id": 7,
        "jsonrpc": "2.0",
        "result": {
          "label": "hew.entity.move",
          "results": [
            {
              "ids": [
                "ins_5"
              ],
              "linked": []
            }
          ]
        }
      }
    },
    {
      "note": "unlink one copy: its own definition, with the remap",
      "request": {
        "id": 8,
        "jsonrpc": "2.0",
        "method": "hew.component.make_unique",
        "params": {
          "path": [
            "ins_4"
          ]
        }
      },
      "response": {
        "id": 8,
        "jsonrpc": "2.0",
        "result": {
          "label": "hew.component.make_unique",
          "results": [
            {
              "component": "cmp_6",
              "instance": "ins_4",
              "remap": {
                "cmp_2": "cmp_6",
                "obj_1": "obj_7"
              }
            }
          ]
        }
      }
    },
    {
      "note": "make the unlinked copy a named component",
      "request": {
        "id": 9,
        "jsonrpc": "2.0",
        "method": "hew.component.promote",
        "params": {
          "component": "cmp_6",
          "name": "Shelf"
        }
      },
      "response": {
        "id": 9,
        "jsonrpc": "2.0",
        "result": {
          "label": "hew.component.promote",
          "results": [
            {
              "component": "cmp_6"
            }
          ]
        }
      }
    },
    {
      "note": "a named component is not a linked set",
      "request": {
        "id": 10,
        "jsonrpc": "2.0",
        "method": "hew.component.promote",
        "params": {
          "component": "cmp_6",
          "name": "Shelf"
        }
      },
      "response": "not_linked",
      "compare": "/error/data/refusal"
    },
    {
      "compare": "/result/results/1/object_id",
      "note": "the cleat",
      "request": {
        "id": 11,
        "jsonrpc": "2.0",
        "method": "hew.doc.transact",
        "params": {
          "label": "cleat",
          "commands": [
            {
              "as": "r",
              "method": "hew.sketch.draw_rect",
              "params": {
                "corner_a": [
                  0.3,
                  0.0,
                  0.0
                ],
                "corner_b": [
                  0.7,
                  0.2,
                  0.0
                ],
                "plane": {
                  "ground": true
                }
              }
            },
            {
              "method": "hew.solid.extrude",
              "params": {
                "distance": 0.018,
                "region": {
                  "$ref": "r#/region_id"
                }
              }
            }
          ]
        }
      },
      "response": "obj_9"
    },
    {
      "note": "joining a linked copy with a world board asks first",
      "request": {
        "id": 12,
        "jsonrpc": "2.0",
        "method": "hew.solid.union",
        "params": {
          "a": "ins_3",
          "b": "obj_9"
        }
      },
      "response": {
        "detail": {
          "operands": [
            "ins_3"
          ]
        },
        "explanation": "An operand is a placement of shared geometry (a linked copy or a component). Joining it splits it from its other copies; pass \"unlink\": true to unlink and explode it first, or edit through its definition.",
        "failed_index": 0,
        "failed_method": "hew.solid.union",
        "refusal": "would_unlink"
      },
      "compare": "/error/data"
    },
    {
      "note": "with unlink: true the copy is exploded and joined; its sibling keeps the set",
      "request": {
        "id": 13,
        "jsonrpc": "2.0",
        "method": "hew.solid.union",
        "params": {
          "a": "ins_3",
          "b": "obj_9",
          "unlink": true
        }
      },
      "response": {
        "id": 13,
        "jsonrpc": "2.0",
        "result": {
          "label": "hew.solid.union",
          "results": [
            {
              "result": "obj_b",
              "unlinked": [
                "ins_3"
              ]
            }
          ]
        }
      }
    },
