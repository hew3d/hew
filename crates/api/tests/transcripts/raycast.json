{
  "frames": [
    {
      "compare": "/result/profile",
      "note": "the handshake",
      "request": {
        "id": 0,
        "jsonrpc": "2.0",
        "method": "hew.meta.hello",
        "params": {
          "protocol": 1
        }
      },
      "response": "core"
    },
    {
      "note": "attach binds the connection",
      "request": {
        "id": 1,
        "jsonrpc": "2.0",
        "method": "hew.doc.attach",
        "params": {}
      },
      "response": {
        "id": 1,
        "jsonrpc": "2.0",
        "result": {}
      }
    },
    {
      "compare": "/result/label",
      "note": "box floor",
      "request": {
        "id": 2,
        "jsonrpc": "2.0",
        "method": "hew.doc.transact",
        "params": {
          "commands": [
            {
              "as": "r",
              "method": "hew.sketch.draw_rect",
              "params": {
                "corner_a": [
                  -1.0,
                  0.0,
                  0.0
                ],
                "corner_b": [
                  4.0,
                  2.0,
                  0.0
                ],
                "plane": {
                  "ground": true
                }
              }
            },
            {
              "method": "hew.solid.extrude",
              "params": {
                "distance": 0.05,
                "region": {
                  "$ref": "r#/region_id"
                }
              }
            }
          ],
          "label": "floor"
        }
      },
      "response": "floor"
    },
    {
      "compare": "/result/label",
      "note": "box board",
      "request": {
        "id": 3,
        "jsonrpc": "2.0",
        "method": "hew.doc.transact",
        "params": {
          "commands": [
            {
              "as": "r",
              "method": "hew.sketch.draw_rect",
              "params": {
                "corner_a": [
                  0.0,
                  0.0,
                  0.0
