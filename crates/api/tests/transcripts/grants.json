{
  "profile": "plugin",
  "grant": {
    "ceiling": "app",
    "permissions": [
      "model.read",
      "attributes.write",
      "documents.save"
    ],
    "plugin": "com.example.plugin",
    "app": null,
    "document": "doc_1"
  },
  "frames": [
    {
      "note": "a plugin hello reports profile plugin, echoes the grant, and lists only the bound document (none on this host)",
      "request": {
        "jsonrpc": "2.0",
        "id": 0,
        "method": "hew.meta.hello",
        "params": {
          "protocol": 1
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 0,
        "result": {
          "protocol": 1,
          "app": {
            "name": "hew",
            "version": "1.3.1"
          },
          "profile": "plugin",
          "grant": {
            "ceiling": "app",
            "permissions": [
              "model.read",
              "attributes.write",
              "documents.save"
            ],
            "plugin": "com.example.plugin",
            "app": null,
            "document": "doc_1"
          },
          "encoding": "json",
          "documents": []
        }
      }
    },
    {
      "note": "a bare attach binds to the grant's document and is always granted",
      "request": {
        "jsonrpc": "2.0",
        "id": 1,
        "method": "hew.doc.attach",
        "params": {}
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": {}
      }
    },
    {
      "note": "attaching by name without documents.other is refused, even to the bound document",
      "request": {
        "jsonrpc": "2.0",
        "id": 12,
        "method": "hew.doc.attach",
        "params": {
          "document": "doc_1"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 12,
        "error": {
          "code": -32000,
          "message": "refused",
          "data": {
            "refusal": "document_not_granted",
            "failed_index": 0,
            "failed_method": "hew.doc.attach",
            "detail": {},
            "explanation": "This connection is bound to one document and may not attach to another. Ask the user for documents.other."
          }
        }
      }
    },
    {
      "note": "model.read reaches attribute reads",
      "request": {
        "jsonrpc": "2.0",
        "id": 2,
        "method": "hew.attr.get",
        "params": {
          "target": "document"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 2,
        "result": {}
      }
    },
    {
      "note": "a command whose permission the grant does not hold is -32001",
      "request": {
        "jsonrpc": "2.0",
        "id": 3,
        "method": "hew.sketch.draw_rect",
        "params": {
          "plane": {
            "ground": true
          },
          "corner_a": [
            0,
            0,
            0
          ],
          "corner_b": [
            1,
            1,
            0
          ]
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 3,
        "error": {
          "code": -32001,
          "message": "method not in the granted profile"
        }
      }
    },
    {
      "note": "inside a transaction the grant gate is static and names the index",
      "request": {
        "jsonrpc": "2.0",
        "id": 4,
        "method": "hew.doc.transact",
        "params": {
          "commands": [
            {
              "method": "hew.attr.get",
              "params": {
                "target": "document"
              }
            },
            {
              "method": "hew.sketch.draw_rect",
              "params": {
                "plane": {
                  "ground": true
                },
                "corner_a": [
                  0,
                  0,
                  0
                ],
                "corner_b": [
                  1,
                  1,
                  0
                ]
              }
            }
          ]
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 4,
        "error": {
          "code": -32001,
          "message": "method not in the granted profile",
          "data": {
            "index": 1
          }
        }
      }
    },
    {
      "note": "attributes.write covers the plugin's own namespace only",
      "request": {
        "jsonrpc": "2.0",
        "id": 5,
        "method": "hew.attr.set",
        "params": {
          "target": "document",
          "ns": "com.example.other",
          "key": "k",
          "value": 1
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 5,
        "error": {
          "code": -32000,
          "message": "refused",
          "data": {
            "refusal": "attr_namespace_not_granted",
            "failed_index": 0,
            "failed_method": "hew.attr.set",
            "detail": {
              "ns": "com.example.other",
              "plugin": "com.example.plugin",
              "app": null
            },
            "explanation": "This connection may write attributes only under its own namespace, \"com.example.plugin\", and names below it. Use that namespace, or ask the user for attributes.write:com.example.other."
          }
        }
      }
    },
    {
      "note": "a namespace below the plugin's own id is granted",
      "request": {
        "jsonrpc": "2.0",
        "id": 6,
        "method": "hew.attr.set",
        "params": {
          "target": "document",
          "ns": "com.example.plugin.parts",
          "key": "k",
          "value": 1
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 6,
        "result": {
          "results": [
            {}
          ],
          "label": "hew.attr.set"
        }
      }
    },
    {
      "note": "the hew reservation is checked first, unchanged",
      "request": {
        "jsonrpc": "2.0",
        "id": 7,
        "method": "hew.attr.set",
        "params": {
          "target": "document",
          "ns": "hew.x",
          "key": "k",
          "value": 1
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 7,
        "error": {
          "code": -32000,
          "message": "refused",
          "data": {
            "refusal": "reserved_attr_namespace",
            "failed_index": 0,
            "failed_method": "hew.attr.set",
            "detail": {
              "ns": "hew.x"
            },
            "explanation": "The \"hew\" attribute namespace is reserved for Hew's own data. Store yours under a namespace you own, like \"com.example.myapp\"."
          }
        }
      }
    },
    {
      "note": "a bound grant without documents.other may not name a document",
      "request": {
        "jsonrpc": "2.0",
        "id": 8,
        "method": "hew.attr.get",
        "params": {
          "target": "document"
        },
        "document": "doc_1"
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 8,
        "error": {
          "code": -32001,
          "message": "document not granted to this connection",
          "data": {
            "refusal": "document_not_granted",
            "document": "doc_1"
          }
        }
      }
    },
    {
      "note": "a restricted grant may not set a path parameter",
      "request": {
        "jsonrpc": "2.0",
        "id": 9,
        "method": "hew.doc.export",
        "params": {
          "format": "stl",
          "path": "/tmp/x.stl"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 9,
        "error": {
          "code": -32001,
          "message": "path parameters are not granted to this connection",
          "data": {
            "refusal": "path_not_granted",
            "method": "hew.doc.export",
            "pointer": "/path"
          }
        }
      }
    },
    {
      "note": "view commands need view",
      "request": {
        "jsonrpc": "2.0",
        "id": 10,
        "method": "hew.view.camera",
        "params": {
          "view": "iso"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 10,
        "error": {
          "code": -32001,
          "message": "method not in the granted profile"
        }
      }
    },
    {
      "note": "closing a window needs documents.discard",
      "request": {
        "jsonrpc": "2.0",
        "id": 11,
        "method": "hew.doc.close",
        "params": {}
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 11,
        "error": {
          "code": -32001,
          "message": "method not in the granted profile"
        }
      }
    }
  ]
}
