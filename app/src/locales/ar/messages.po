msgid "Click a face to push or pull it — double-click repeats the last distance."
msgstr "انقر وجها لدفعه أو سحبه — النقر المزدوج يكرر المسافة الأخيرة."

#: src/tools/PushPullTool.ts
msgid "Click a face to push or pull it — double-click repeats the last distance. Ctrl is on — extrudes a new object."
msgstr "انقر وجها لدفعه أو سحبه — النقر المزدوج يكرر المسافة الأخيرة. Ctrl مفعل — يبثق كائنا جديدا."

#: src/tools/SectionPlaneTool.ts
msgid "Click a face to section it there, or click the ground for a horizontal cut."
msgstr "انقر وجها لتقطيعه هناك، أو انقر الأرضية لقطع أفقي."

#: src/tools/TextTool.ts
msgid "Click a face, edge, or point to anchor the leader text."
msgstr "انقر وجها أو حافة أو نقطة لتثبيت نص الإشارة."

#: src/tools/TextPlaceTool.ts
msgid "Click a face, the ground, or an arrow-locked plane to place the text."
msgstr "انقر وجها أو الأرضية أو مستوى مثبتا بسهم لوضع النص."

#: src/panels/PrintDialog.tsx
msgid "Click a page to see it at 100 %"
msgstr "انقر صفحة لعرضها بنسبة 100 %"

#: src/tools/AxesTool.ts
msgid "Click a point along the new green (Y) axis — not in line with the first two."
msgstr "انقر نقطة على المحور الأخضر (Y) الجديد — بشرط ألا تكون على استقامة النقطتين الأوليين."

#: src/tools/AxesTool.ts
msgid "Click a point along the new red (X) axis."
msgstr "انقر نقطة على المحور الأحمر (X) الجديد."

#: src/tools/AxesTool.ts
msgid "Click a point for the new origin."
msgstr "انقر نقطة لتكون نقطة الأصل الجديدة."

#: src/tools/DimensionTool.ts
msgid "Click a point to dimension from, a line to dimension it, or a drawn circle/arc for a radius dimension."
msgstr "انقر نقطة للقياس منها، أو خطا لقياسه، أو دائرة أو قوسا مرسومين لبعد نصف القطر."

#: src/tools/TapeMeasureTool.ts
msgid "Click a point to measure from — or click an edge to drop a parallel guide."
msgstr "انقر نقطة للقياس منها — أو انقر حافة لإسقاط خط إرشادي مواز."

#: src/tools/ProtractorTool.ts
msgid "Click a point to set the baseline direction."
msgstr "انقر نقطة لتحديد اتجاه خط الأساس."

#: src/tools/EditVertexTool.ts
msgid "Click a sketch point to pick it up."
msgstr "انقر نقطة في الرسم لالتقاطها."

#: src/tools/SliceTool.ts
msgid "Click a solid to cut it along the plane — arrow keys aim the plane along an axis, hovering a face aligns to it, or type an offset."
msgstr "انقر مجسما مصمتا لتقطيعه على المستوى — مفاتيح الأسهم توجه المستوى بمحاذاة محور، ومرور المؤشر على وجه يحاذيه، أو اكتب إزاحة."

#: src/tools/RotateTool.ts
msgid "Click a start point for the angle. Shift or → / ← / ↑ lock the rotation axis."
msgstr "انقر نقطة بداية للزاوية. Shift أو → / ← / ↑ تثبت محور التدوير."

#: src/tools/RotateTool.ts
msgid "Click a start point for the angle. Shift or → / ← / ↑ lock the rotation axis. Tap {COPY_MODIFIER_LABEL} to rotate instead."
msgstr "انقر نقطة بداية للزاوية. Shift أو → / ← / ↑ تثبت محور التدوير. اضغط {COPY_MODIFIER_LABEL} للتدوير بدلا من ذلك."

#: src/tools/PositionTextureTool.ts
msgid "Click a textured face to position its texture."
msgstr "انقر وجها ذا خامة لتحديد موضع خامته."

#: src/tools/MoveTool.ts
msgid "Click an object to move it"
msgstr "انقر كائنا لتحريكه"

#: src/tools/RotateTool.ts
msgid "Click an object to rotate it"
msgstr "انقر كائنا لتدويره"

#: src/tools/ScaleTool.ts
msgid "Click an object to scale it"
msgstr "انقر كائنا لتحجيمه"

#: src/tools/ArcTool.ts
msgid "Click the arc's first endpoint — on the ground plane or any face or sketch."
msgstr "انقر نقطة النهاية الأولى للقوس — على المستوى الأرضي أو أي وجه أو رسم."

#: src/tools/ArcTool.ts
msgid "Click the arc's second endpoint — or type an exact chord length."
msgstr "انقر نقطة النهاية الثانية للقوس — أو اكتب طول وتر محددا."

#: src/tools/CircleTool.ts
msgid "Click the circle's center — on the ground plane or any face or sketch."
msgstr "انقر مركز الدائرة — على المستوى الأرضي أو أي وجه أو رسم."

#: src/tools/MoveTool.ts
msgid "Click the destination — type an exact distance, arrow keys lock an axis, tap {COPY_MODIFIER_LABEL} to place a copy."
msgstr "انقر الوجهة — اكتب مسافة محددة، ومفاتيح الأسهم تثبت محورا، واضغط {COPY_MODIFIER_LABEL} لوضع نسخة."

#: src/tools/RectangleTool.ts
msgid "Click the first corner — on the ground plane or any face or sketch."
msgstr "انقر الركن الأول — على المستوى الأرضي أو أي وجه أو رسم."

#: src/tools/PlaceImageTool.ts
msgid "Click the first corner of \"{name}\" — on the ground or any face. Esc cancels."
msgstr "انقر الركن الأول من \"{name}\" — على الأرضية أو أي وجه. Esc يلغي."

#: src/tools/FollowMeTool.ts
msgid "Click the flat face to run the profile around it — or a drawn line or curve to follow."
msgstr "انقر الوجه المستوي لتمرير المقطع حوله — أو خطا أو منحنى مرسومين لتتبعه."

#: src/tools/LineTool.ts
msgid "Click the next point — type a length for an exact segment; double-click or Esc to finish."
msgstr "انقر النقطة التالية — اكتب طولا لقطعة محددة؛ انقر نقرا مزدوجا أو اضغط Esc للإنهاء."

#: src/tools/MoveTool.ts
msgid "Click the object you want to move."
msgstr "انقر على الكائن المراد تحريكه."

#: src/tools/RotateTool.ts
msgid "Click the object you want to rotate."
msgstr "انقر على الكائن المراد تدويره."

#: src/tools/ScaleTool.ts
msgid "Click the object you want to scale."
msgstr "انقر على الكائن المراد تحجيمه."

#: src/tools/RectangleTool.ts
msgid "Click the opposite corner — or type exact dimensions."
msgstr "انقر على الركن المقابل — أو اكتب الأبعاد الدقيقة."

#: src/tools/PlaceImageTool.ts
msgid "Click the opposite corner — or type the width and press Enter."
msgstr "انقر على الركن المقابل — أو اكتب العرض واضغط Enter."

#: src/tools/FollowMeTool.ts
msgid "Click the path to follow — a drawn line or curve, or a solid face to run around."
msgstr "انقر على المسار المراد تتبّعه — خط أو منحنى مرسوم، أو وجه مجسّم مصمت للسير حوله."

#: src/tools/PolygonTool.ts
msgid "Click the polygon's center — on the ground plane or any face or sketch."
msgstr "انقر على مركز المضلّع — على المستوى الأرضي أو أي وجه أو رسم."

#: src/tools/FollowMeTool.ts
msgid "Click the profile to sweep along the highlighted path — a solid-face click follows that face instead; Esc re-picks the path."
msgstr "انقر على المقطع لسحبه على طول المسار المميز — النقر على وجه مجسّم مصمت يتبع ذلك الوجه بدلًا من ذلك؛ Esc يعيد اختيار المسار."

#: src/tools/FollowMeTool.ts
msgid "Click the profile to sweep along the highlighted path, or drag along it for a partial sweep."
msgstr "انقر على المقطع لسحبه على طول المسار المميز، أو اسحب على طوله لسحب جزئي."

#: src/tools/TapeMeasureTool.ts
msgid "Click the second point to read the distance — or type an exact distance to drop a guide there."
msgstr "انقر على النقطة الثانية لقراءة المسافة — أو اكتب مسافة دقيقة لإسقاط خط إرشادي هناك."

#: src/tools/DimensionTool.ts
msgid "Click the second point."
msgstr "انقر على النقطة الثانية."

#: src/App.tsx
msgid "click the view to look with the mouse · W S forward/back · A D strafe · E Q up/down · scroll looks · pinch sets speed · Shift fast · Esc exits"
msgstr "انقر على العرض للنظر بالماوس · W S للأمام/للخلف · A D للحركة الجانبية · E Q للأعلى/للأسفل · التمرير للنظر · الضمّ يضبط السرعة · Shift أسرع · Esc للخروج"

#: src/tools/SectionPlaneTool.ts
msgid "Click the widget then move to sweep the cut; click a face to re-place. Delete removes it; toggle it off from View ▸ Section Cut."
msgstr "انقر على المقبض ثم حرّك لسحب القطع؛ انقر على وجه لإعادة التموضع. مفتاح الحذف يزيله؛ أوقفه من عرض ▸ مستوى القطع."

#: src/tools/FollowMeTool.ts
msgid "Click this face to sweep it as the profile — it merges straight into the solid the path runs on."
msgstr "انقر على هذا الوجه لسحبه كمقطع — يندمج مباشرة في المجسّم المصمت الذي يسير عليه المسار."

