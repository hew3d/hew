---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ReelFrame from '../components/ReelFrame.astro';
import { resolveReel } from '../lib/reel';
import ScreenshotFrame from '../components/ScreenshotFrame.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import Comparison from '../components/Comparison.astro';
import CtaBand from '../components/CtaBand.astro';

const entry = await getEntry('pages', 'landing');
// The reel sits under the hero once it is published (or when previewing a
// local render); the screenshot rotator keeps its own place further down,
// above the comparison.
const reelMedia = resolveReel();
if (!entry) {
  throw new Error('Missing content/pages/landing.md entry');
}

const {
  title,
  description,
  hero,
  reel,
  screenshots,
  features,
  comparisonTitle,
  comparisonIntro,
  comparison,
  closingCta,
} = entry.data;
---

<BaseLayout title={title} description={description ?? ''} noSiteName>
  {
    hero && (
      <Hero
        eyebrow={hero.eyebrow}
        title={hero.title}
        tagline={hero.tagline}
        primaryCta={hero.primaryCta}
        secondaryCta={hero.secondaryCta}
      />
    )
  }

  {reel && reelMedia && <ReelFrame media={reelMedia} label={reel.label} caption={reel.caption} />}

  {features && features.length > 0 && <FeatureGrid features={features} />}

  {
    screenshots && screenshots.length > 0 && (
      <ScreenshotFrame screenshots={screenshots} />
    )
  }

  {
    comparisonTitle && comparison && comparison.length > 0 && (
      <Comparison
        comparisonTitle={comparisonTitle}
        comparisonIntro={comparisonIntro}
        comparison={comparison}
      />
    )
  }

  {
    closingCta && (
      <CtaBand
        title={closingCta.title}
        body={closingCta.body}
        primaryCta={closingCta.primaryCta}
        secondaryCta={closingCta.secondaryCta}
      />
    )
  }
</BaseLayout>
