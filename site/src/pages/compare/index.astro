---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('compare')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Compare"
  description="What Hew looks like from the 3D tool you already know — SketchUp, Blender, Fusion 360, FreeCAD, Plasticity, or Tinkercad. Where they overlap, where they don't, stated plainly."
>
  <div class="container compare-page">
    <header class="page-head">
      <h1>Coming from another 3D tool?</h1>
      <p class="intro">
        Nobody learns Hew first. Whatever you model in today, these pages
        describe Hew from that tool's point of view: what carries over, what
        works differently, and what each side has that the other doesn't.
        They're comparisons, not sales pitches — where Hew falls short, they
        say so.
      </p>
    </header>

    <ul class="compare-list">
      {
        entries.map((entry) => (
          <li>
            <a class="compare-card" href={`/compare/${entry.id}/`}>
              <span class="compare-eyebrow">Coming from</span>
              <h2>{entry.data.package}</h2>
              <p>{entry.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .compare-page {
    padding-block: var(--space-2xl) var(--space-3xl);
  }

  .page-head {
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }

  .page-head .intro {
    margin-top: var(--space-sm);
    font-size: 1.0625rem;
    color: var(--color-text-muted);
  }

  .compare-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-lg);
  }

  .compare-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .compare-card:hover {
    border-color: var(--color-accent);
  }

  .compare-eyebrow {
    font-size: 0.75rem;
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent-text);
  }

  .compare-card h2 {
    font-size: 1.25rem;
  }

  .compare-card p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  @media (max-width: 40rem) {
    .compare-list {
      grid-template-columns: 1fr;
    }
  }
</style>
