---
// The launch reel under the landing hero: a muted, looping, autoplaying
// capture of the app doing its thing — no chrome, no captions, one
// capability per cut. `media` comes from src/lib/reel.ts.
import type { ReelMedia } from '../lib/reel';

interface Props {
  media: ReelMedia;
  /** Accessible label for the video. */
  label: string;
  /** Optional one-line caption under the frame. */
  caption?: string;
}

const { media, label, caption } = Astro.props;
---

<section class="reel-section">
  <div class="container">
    <figure class="frame" data-reel>
      <video
        muted
        autoplay
        loop
        playsinline
        preload="metadata"
        poster={media.poster}
        aria-label={label}
      >
        <source src={media.webm} type='video/webm; codecs="av01.0.08M.08"' />
        <source src={media.mp4} type='video/mp4; codecs="avc1.640028"' />
      </video>
      <button type="button" class="toggle" aria-label="Pause">
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 4h4v16H6zM14 4h4v16h-4z"/></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5v15l13-7.5z"/></svg>
      </button>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  </div>
</section>

<script>
  // Click anywhere on the frame to pause/resume. Visitors who prefer reduced
  // motion get the poster and a play button instead of autoplay.
  document.querySelectorAll<HTMLElement>('[data-reel]').forEach((frame) => {
    const video = frame.querySelector('video');
    const toggle = frame.querySelector<HTMLButtonElement>('.toggle');
    if (!video || !toggle) return;
    const paint = () => {
      const paused = video.paused;
      frame.toggleAttribute('data-paused', paused);
      toggle.setAttribute('aria-label', paused ? 'Play' : 'Pause');
    };
    const flip = () => {
      if (video.paused) void video.play().catch(() => {});
      else video.pause();
    };
    video.addEventListener('click', flip);
    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      flip();
    });
    video.addEventListener('play', paint);
    video.addEventListener('pause', paint);
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
    }
    paint();
  });
</script>

<style>
  .reel-section {
    padding-block: 0 var(--space-2xl);
  }

  .frame {
    position: relative;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    /* the captures are dark-theme; a dark ground keeps letterboxing invisible */
    background: #15181d;
    box-shadow: var(--shadow-md);
    line-height: 0;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    cursor: pointer;
  }

  .toggle {
    position: absolute;
    right: var(--space-sm);
    bottom: var(--space-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgb(27 26 23 / 0.6);
    color: #f3ede3;
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-standard);
  }

  .toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: currentColor;
  }

  .icon-play,
  .frame[data-paused] .icon-pause {
    display: none;
  }

  .frame[data-paused] .icon-play {
    display: block;
  }

  .frame:hover .toggle,
  .frame[data-paused] .toggle,
  .toggle:focus-visible {
    opacity: 1;
  }

  .toggle:focus-visible {
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 2px;
  }

  figcaption {
    padding: var(--space-xs) var(--space-md);
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
    text-align: center;
  }
</style>
