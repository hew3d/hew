{
  "manifest": 1,
  "id": "com.example.wasm-job",
  "name": "Wasm Job",
  "version": "0.1.0",
  "description": "Counts primes with a small WebAssembly module, compiled once and run in several nested Workers.",
  "api": 1,
  "main": "dist/background.js",
  "permissions": ["model.read"],
  "activation": ["on_command"],
  "contributes": {
    "commands": [
      {
        "id": "run",
        "class": "read_only",
        "summary": "Counts the primes below a limit, split across nested Workers that share one compiled module.",
        "timeout_ms": 120000,
        "params": {
          "type": "object",
          "properties": {
            "limit": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "workers": { "type": "integer", "minimum": 1, "maximum": 16 },
            "only": { "type": "integer", "minimum": 0, "maximum": 15 }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "limit": {},
            "workers": {},
            "primes": {},
            "slices": {},
            "compiles": {},
            "wallMs": {},
            "bytes": {}
          },
          "additionalProperties": false
        }
      },
      {
        "id": "ping",
        "class": "read_only",
        "summary": "Answers at once, to show the plugin is still listening while a job runs.",
        "result": { "type": "object", "properties": { "alive": { "type": "boolean" }, "at": {} }, "additionalProperties": false }
      },
      {
        "id": "iso",
        "class": "read_only",
        "summary": "Says whether the plugin's Worker, and a Worker it starts, is cross-origin isolated.",
        "result": {
          "type": "object",
          "properties": { "isolated": {}, "nested": {}, "sharedArrayBuffer": {}, "cores": {} },
          "additionalProperties": false
        }
      }
    ]
  }
}
